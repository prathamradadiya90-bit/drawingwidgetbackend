      "type": "string"
    },
    {
      "key": "user_alice_id",
      "value": "8f3c1a2e-0001-4000-8000-000000000001",
      "type": "string"
    },
    {
      "key": "user_bob_id",
      "value": "8f3c1a2e-0002-4000-8000-000000000002",
      "type": "string"
    },
    {
      "key": "alice_friend_code",
      "value": "",
