{
  "info": {
    "_postman_id": "friends-49a1-43e2-88f1-30219488a077",
    "name": "Friends & Game Invites API & WebSockets",
    "description": "Complete Postman collection for testing the Friends System and Game Invites. Covers user registration, 8-character permanent friend codes, lookups, mutual friend list, friend removal, and Socket.IO real-time invites.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
