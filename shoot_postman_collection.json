    "name": "Shoot Game Multiplayer API & WebSockets",
    "description": "Complete Postman collection for testing the Shoot Game (\"Shoot your best shot\" 2-player online multiplayer target shooting game). Covers REST lobby endpoints, status transitions, validation errors, and Socket.IO real-time event definitions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
